POSTGRES_DB=aegisops
POSTGRES_USER=aegisops
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://aegisops:change_me@postgres:5432/aegisops

# Qdrant vector database
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=memories

# Neo4j graph database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=aegisops
NEO4J_DATABASE=neo4j

# LLM provider
# "test" uses the labelled deterministic provider; set "openai" and OPENAI_API_KEY for model answers
LLM_PROVIDER=test
LLM_MODEL=gpt-5.6-terra
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=15

# Embeddings: fake (SHA-256 test vectors) or hashed_terms (lexical, word-based ranking)
EMBEDDING_PROVIDER=fake

# Projection stores: connect timeout and fail-fast window after a failure (seconds)
PROJECTION_CONNECT_TIMEOUT_SECONDS=2
PROJECTION_RETRY_SECONDS=15

# Optional outbound Kafka stream for external systems (compose profile "integration")
KAFKA_ENABLED=false

# Sign-in. local = no sign-in (loopback development); token = static API tokens
# (AUTH_TOKENS_JSON); oidc = people sign in through an OpenID Connect provider.
# For the bundled Keycloak: AUTH_MODE=oidc and COMPOSE_PROFILES=auth, then
# docker compose up -d. Starter users and roles: deploy/keycloak/README.md.
AUTH_MODE=local
# COMPOSE_PROFILES=auth
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak
# Another provider (Entra ID, Okta, Clerk): set these instead of using Keycloak.
# OIDC_ISSUER=http://localhost:8080/realms/aegisops
# OIDC_CLIENT_ID=aegisops-console
# OIDC_JWKS_URL=http://keycloak:8080/realms/aegisops/protocol/openid-connect/certs
# OIDC_ROLES_CLAIM=realm_access.roles
