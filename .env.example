POSTGRES_DB=aegisops
POSTGRES_USER=aegisops
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://aegisops:change_me@postgres:5432/aegisops

# Qdrant vector database
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=memories

# Neo4j graph database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=aegisops
NEO4J_DATABASE=neo4j

# LLM provider
# "test" uses the labelled deterministic provider; set "openai" and OPENAI_API_KEY for model answers
LLM_PROVIDER=test
LLM_MODEL=gpt-5.6-terra
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=15

# Embeddings: fake (SHA-256 test vectors) or hashed_terms (lexical, word-based ranking)
EMBEDDING_PROVIDER=fake

# Projection stores: connect timeout and fail-fast window after a failure (seconds)
PROJECTION_CONNECT_TIMEOUT_SECONDS=2
PROJECTION_RETRY_SECONDS=15

# Optional outbound Kafka stream for external systems (compose profile "integration")
KAFKA_ENABLED=false
