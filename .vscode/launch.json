{
  "version": "0.2.0",
  "configurations": [{
    "name": "AegisOps: local API and console",
    "type": "debugpy", "request": "launch",
    "program": "${workspaceFolder}/scripts/run_local.py",
    "python": "${workspaceFolder}/.venv/Scripts/python.exe",
    "cwd": "${workspaceFolder}", "console": "integratedTerminal",
    "justMyCode": true,
    "serverReadyAction": {"action": "openExternally", "pattern": "Uvicorn running on (http://[^ ]+)", "uriFormat": "%s/console/"}
  }]
}
