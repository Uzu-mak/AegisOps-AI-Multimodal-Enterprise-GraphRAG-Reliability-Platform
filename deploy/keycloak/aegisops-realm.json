{
  "realm": "aegisops",
  "enabled": true,
  "displayName": "AegisOps",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 28800,
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Reads records, investigations and evaluation results"
      },
      {
        "name": "engineer",
        "description": "Investigates, records findings, imports work orders, drafts question sets"
      },
      {
        "name": "reviewer",
        "description": "Approves or returns question sets (never their own)"
      },
      {
        "name": "admin",
        "description": "Manages users and system pages; can do everything"
      }
    ]
  },
  "clients": [
    {
      "clientId": "aegisops-console",
      "name": "AegisOps console",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:8000/console/*",
        "http://127.0.0.1:8000/console/*"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "http://127.0.0.1:8000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8000/console/*##http://127.0.0.1:8000/console/*"
      },
      "protocolMappers": [
        {
          "name": "aegisops-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "aegisops-console",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "jeremiah",
      "firstName": "Jeremiah",
      "lastName": "Afari Opoku-Acheampong",
      "email": "jeremiah@aegisops.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "ChangeMe-2026!",
          "temporary": true
        }
      ],
      "realmRoles": [
        "engineer",
        "admin"
      ],
      "requiredActions": [
        "UPDATE_PASSWORD"
      ]
    },
    {
      "username": "bismark",
      "firstName": "Bismark",
      "lastName": "Mensah",
      "email": "bismark@aegisops.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "ChangeMe-2026!",
          "temporary": true
        }
      ],
      "realmRoles": [
        "reviewer"
      ],
      "requiredActions": [
        "UPDATE_PASSWORD"
      ]
    },
    {
      "username": "plant.viewer",
      "firstName": "Plant",
      "lastName": "Viewer",
      "email": "viewer@aegisops.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "ChangeMe-2026!",
          "temporary": true
        }
      ],
      "realmRoles": [
        "viewer"
      ],
      "requiredActions": [
        "UPDATE_PASSWORD"
      ]
    }
  ]
}
